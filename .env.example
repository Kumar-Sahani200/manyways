# Copy to environment settings or an ignored .env.local. Never commit real secrets.
# Next.js on manyways.si (marketing, Clerk sign-in, dashboard, editor)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/workspace
# Server-only FastAPI origin. Local development:
MANYWAYS_API_URL=http://127.0.0.1:8000
# Production value after Render/DNS are connected: https://app.manyways.si

# FastAPI + worker on Render (app.manyways.si is the API, not a user-facing site)
MONGODB_URI=
MONGODB_DATABASE=manyways
CLERK_ISSUER_URL=
# Comma-separated exact origins allowed in Clerk JWT azp; include preview origin for dev.
CLERK_AUTHORIZED_PARTIES=https://manyways.si,https://www.manyways.si
# Optional: validate aud when your Clerk JWT template issues it.
CLERK_JWT_AUDIENCE=
# Browser normally uses the Next.js gateway, so API CORS may remain empty.
API_ALLOWED_ORIGINS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Disable optional LangSmith tracing; do not export private story content to tracing services.
LANGSMITH_TRACING=false
AGENT_CONCURRENCY=3
