# Place real credentials in secure environment settings, never in this file.
# Next.js server (Vercel / local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=manyways-api
STORY_API_URL=http://127.0.0.1:8000
# Required in production; comma-separated exact frontend origins
APP_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
APP_ENV=development
# For the separate marketing deployment only:
NEXT_PUBLIC_WORKSPACE_URL=

# FastAPI (separate always-running service)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWT_AUDIENCE=manyways-api
MONGODB_URI=
MONGODB_DATABASE=manyways

# Worker ONLY; never configure provider keys in NEXT_PUBLIC variables
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=3600
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_AGENT_ID=
